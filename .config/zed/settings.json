{
  "base_keymap": "VSCode",
  "auto_update": true,
  "disable_ai": true,
  "use_podman": true,

  // This prevents Zed from downloading Node.
  "node": {
    "ignore_system_version": false,
  },

  /*
   * Panels and windows
   */

  "cli_default_open_behavior": "existing_window",
  "restore_on_startup": "launchpad",
  "session": {
    "restore_unsaved_buffers": true,
    "trust_all_worktrees": false,
  },

  /*
   * Appearance
   */

  "ui_font_family": "Inter BKHL Variable",
  "buffer_font_family": "Iosevka BKHL Sans Normal",
  "ui_font_size": 18.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Modus Operandi",
    "dark": "Modus Vivendi Tritanopia",
  },

  /*
   * Extensions
   */

  "auto_install_extensions": {
    "ansible": true,
    "csv": true,
    "dockerfile": true,
    "git-firefly": true,
    "github-actions": true,
    "golangci-lint": true,
    "helm": true,
    "html": true,
    "ini": true,
    "json5": true,
    "lua": true,
    "make": true,
    "modus-themes": true,
    "perl": true,
    "scss": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "xml": true,
  },

  // Prevent extensions from downloading language servers &c. I prefer instead
  // to launch them with Podman, see below.
  "granted_extension_capabilities": [
    { "kind": "process:exec", "command": "*", "args": ["**"] },
  ],

  /*
   * Languages and language servers
   */

  // This disables language servers by default, so that I can instead enable
  // them selectively by language or by project.
  "enable_language_server": false,

  // These prevent Zed from downloading and running its own copy of Prettier.
  // Formatter can still be configured per language below.
  "formatter": "language_server",
  "prettier": { "allowed": false },

  "languages": {
    "Dockerfile": {
      "enable_language_server": true,
      "language_servers": ["dockerfile-language-server"],
    },
    "GitHub Actions": {
      "enable_language_server": true,
      "language_servers": ["gh-actions-language-server"],
    },
    "JSONC": {
      "enable_language_server": true,
      "language_servers": ["json-language-server"],
      "formatter": {
        "external": {
          "command": "podman",
          "arguments": [
            "run",
            "--rm",
            "--interactive",
            "--network=none",
            "ghcr.io/bkhl/tool-images/prettier:latest",
            "--parser=jsonc",
            "--trailing-comma=all",
          ],
        },
      },
      "format_on_save": "on",
    },
    "Shell Script": {
      "enable_language_server": true,
      "language_servers": ["bash-language-server"],
    },
    "YAML": {
      "enable_language_server": true,
      "language_servers": ["yaml-language-server"],
    },
  },
  "lsp": {
    "bash-language-server": {
      "binary": {
        "path": "podman",
        "arguments": [
          "run",
          "--rm",
          "--interactive",
          "--pid=host",
          "--userns=keep-id",
          "--network=none",
          "ghcr.io/bkhl/tool-images/bash-language-server:latest",
        ],
      },
      "settings": {
        "bashIde": {
          "shellcheckArguments": "--exclude=SC1091",
          "backgroundAnalysisMaxFiles": 0,
        },
      },
    },
    "dockerfile-language-server": {
      "binary": {
        "path": "podman",
        "arguments": [
          "run",
          "--rm",
          "--interactive",
          "--pid=host",
          "--network=none",
          "ghcr.io/bkhl/tool-images/dockerfile-language-server:latest",
        ],
      },
    },
    "gh-actions-language-server": {
      "binary": {
        "path": "podman",
        "arguments": [
          "run",
          "--rm",
          "--interactive",
          "--pid=host",
          "ghcr.io/bkhl/tool-images/gh-actions-language-server:latest",
        ],
      },
    },
    "json-language-server": {
      "binary": {
        "path": "podman",
        "arguments": [
          "run",
          "--rm",
          "--interactive",
          "--pid=host",
          "--network=none",
          "ghcr.io/bkhl/tool-images/json-lsp:latest",
        ],
      },
    },
    "yaml-language-server": {
      "binary": {
        "path": "podman",
        "arguments": [
          "run",
          "--rm",
          "--interactive",
          "--pid=host",
          "--userns=keep-id",
          "ghcr.io/bkhl/tool-images/yaml-language-server:latest",
        ],
      },
    },
  },

  /*
   * Git
   */

  "git_panel": {
    "group_by": "staging",
  },
  "diff_view_style": "split",
}
